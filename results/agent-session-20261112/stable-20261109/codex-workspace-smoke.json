{
  "date": "2026-11-12",
  "test": "authenticated Codex workspace-write and outside-workspace denial smoke",
  "runtime": {
    "docker_runtime": "runsc-stable-20261109",
    "gvisor_version": "release-20261109.0",
    "image_id": "sha256:1c699e85c4765335983513403bc9edb812ffcc88dab0f9132274406079fdee5a"
  },
  "cli": {
    "name": "Codex",
    "version": "0.167.1",
    "model": "gpt-6-luna",
    "authentication": "interactive device login completed privately; logged out after test"
  },
  "container": {
    "user": "10001:10001",
    "read_only_rootfs": true,
    "capabilities_dropped": ["ALL"],
    "no_new_privileges": true,
    "host_mounts": []
  },
  "codex_sandbox": {
    "mode": "workspace-write",
