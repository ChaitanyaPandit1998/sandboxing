    "outside_workspace_write_denied": true,
    "outside_write_exit_code": 2,
    "outside_write_error": "Read-only file system",
    "outer_container_home_writable_control": true,
    "outer_control_marker_created_read_and_deleted": true,
    "outside_marker_absent_after_test": true
  },
  "cleanup": {
    "codex_logged_out": true,
    "temporary_session_container_removed": true,
    "temporary_proxy_and_networks_removed": true,
    "unrelated_containers_left_running": ["kind_kirch", "flamboyant_kare"]
